{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuneDrop",
  "version": "0.1.0",
  "identifier": "app.dunedrop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "title": "DuneDrop",
        "width": 1240,
        "height": 840,
        "minWidth": 920,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
